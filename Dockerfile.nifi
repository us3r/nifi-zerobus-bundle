FROM apache/nifi:2.12.0

COPY nifi-zerobus-nar/target/nifi-zerobus-nar-2.12.0-2.nar /opt/nifi/nifi-current/lib/

# PutZerobusRecord uses Apache Arrow, which needs reflective access to java.nio
# internals for its off-heap buffers. Without this flag the processor refuses to start.
RUN echo 'java.arg.arrowAddOpens=--add-opens=java.base/java.nio=ALL-UNNAMED' \
      >> /opt/nifi/nifi-current/conf/bootstrap.conf
