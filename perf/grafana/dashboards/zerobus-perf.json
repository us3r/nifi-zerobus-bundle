      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "nifi_amount_items_queued{component_type=\"Connection\",destination_name=~\"PutZerobus.*\"}",
          "legendFormat": "{{destination_name}}"
